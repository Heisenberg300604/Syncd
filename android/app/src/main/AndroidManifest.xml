<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Least privilege: only what implemented features need. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reconnect promptly when the network returns instead of waiting out a backoff. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Media3 MediaSessionService promotes itself to a foreground service while playing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      POST_NOTIFICATIONS is intentionally NOT requested: media-session notifications
      are exempt from the Android 13+ notification permission, and the app posts no
      other notifications.
    -->

    <application
        android:name=".SyncDApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SyncD"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SyncD">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Owns the single ExoPlayer + MediaSession. Exported only for the Media3
          session intent so system UI / Bluetooth / Android Auto controllers can bind.
        -->
        <service
            android:name=".playback.service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
