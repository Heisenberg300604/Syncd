// Shared build settings for every configuration and target.
// Per-developer values (team, keys, URLs) go in Config/Local.xcconfig,
// which is gitignored. Copy Config/Local.example.xcconfig to start.

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_C_LANGUAGE_STANDARD = gnu17
GCC_WARN_UNUSED_VARIABLE = YES
CLANG_WARN_UNREACHABLE_CODE = YES

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SYNCD_BUNDLE_ID = com.syncd.ios
PRODUCT_BUNDLE_IDENTIFIER = $(SYNCD_BUNDLE_ID)

INFOPLIST_KEY_CFBundleDisplayName = SyncD
// Launch screen (SyncD mark on the canvas colour) is defined in Config/SyncD-Info.plist.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.music

// Runtime configuration, surfaced through Config/SyncD-Info.plist.
// NOTE: `//` starts a comment in xcconfig files. Write URLs as
//   https:/$()/api.example.com/api
SYNCD_ENVIRONMENT = development
SYNCD_API_BASE_URL =
SYNCD_CLERK_PUBLISHABLE_KEY =
